rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fields on users/{uid} that grant paid access or reflect billing/
    // credential state. These must only ever be set by the service account
    // (stripe-webhook.js, redeem-workbook-code.js, redeem-access-code.js —
    // all authenticate with a Google OAuth2 access token via _firebaseAdmin.js
    // and so bypass these rules entirely) or by the admin console. A normal
    // user's own client write must never be able to touch them — otherwise
    // any signed-in user could grant themselves paid access with no real
    // Stripe subscription, or flip the platform-wide kill switch.
    // Phase 0 security hardening (2026-09-09) — see docs/HSDOS_AUDIT_2026-09-09.md.
    function privilegedUserFields() {
      return [
        "plan", "subscriptions", "planStatus", "aiMsgLimit", "stripeSubId",
        "planUpdatedAt", "isAdmin", "isFoundingMember", "foundingMemberNumber",
        "foundingClaimedAt", "accessPass",
        "workbookBonusRedeemed", "redeemedWorkbookCode", "workbookBookNumber",
        "workbookBonusStartDate", "workbookBonusEndDate", "workbookAccessStatus",
        "convertedFromWorkbookCode",
        // Phase 1 (2026-09-09): pathway entitlement must not be self-grantable,
        // same reasoning as plan/subscriptions above — see
        // netlify/functions/migrate-pathway-access.js (service-account write)
        // and src/lib/pathwayAccess.js (the resolver that reads this field).
        "pathwayAccess"
      ];
    }
    function touchesPrivilegedFieldsOnCreate() {
      return request.resource.data.keys().hasAny(privilegedUserFields());
    }
    function touchesPrivilegedFieldsOnUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFields());
    }
    // Both owner emails recognized here, matching the client's OWNER_EMAILS
    // list (src/hooks/useAuth.jsx, src/hooks/useSubscription.js, etc: [
    // VITE_ADMIN_EMAIL, "waltho79@gmail.com"]). Originally (2026-09-09,
    // Phase 0) this only guarded users/{uid} and config/{docId} so
    // waltho79@gmail.com's existing auto-grant behavior in useAuth.jsx kept
    // working under the new privileged-field restriction. Per user request
    // the same day, every other admin-only collection in this file (support,
    // adminLogs, adminConfig, feedback, geminiActivity, apiCosts,
    // workbookRedemptions, notifications) was also switched from the single
    // hardcoded hearseedo.english@gmail.com literal to this function, so
    // waltho79@gmail.com now has full, consistent admin access everywhere in
    // this file rather than the narrower original scope.
    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        "hearseedo.english@gmail.com", "waltho79@gmail.com"
      ];
    }

    // ── Public read-only meta (signup counter) ─────────────────────────────
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── AI cache — public read (cache hits), server write only ─────────────
    match /aiCache/{hash} {
      allow read: if true;
      allow write: if false;
    }

    // ── Platform analytics — public read, server write only ────────────────
    // log-page-view writes via service account (bypasses these rules).
    // totalAIMessages is incremented by netlify/functions/chat.js via REST
    // with just the Firebase Web API key (no auth token, no service account)
    // — same pattern as geminiActivity/apiCosts/config below, so it needs the
    // same open create/update carve-out or the increment silently fails.
    match /analytics/{doc} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── App Registry — public read, server write only ──────────────────────
    match /appRegistry/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Referral links — public read (code lookup), owner write ───────────
    match /referralLinks/{code} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // ── Referral stats — owner read only, server write ────────────────────
    match /referrals/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── User profiles — owner read/write (except billing fields), admin full ──
    // Owner may create/update their own doc, but never through fields in
    // privilegedUserFields() — those are billing/entitlement/credential state
    // and must only be set by the service account or the admin console. See
    // the privilegedUserFields() comment above for why.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdminEmail());

      allow create: if request.auth != null && (
        (request.auth.uid == uid && !touchesPrivilegedFieldsOnCreate()) || isAdminEmail()
      );

      allow update: if request.auth != null && (
        (request.auth.uid == uid && !touchesPrivilegedFieldsOnUpdate()) || isAdminEmail()
      );

      allow delete: if request.auth != null && request.auth.uid == uid;

      match /chatUsage/{day} {
        // Lambda reads/writes without a Firebase auth token (server-side rate-limit counter).
        // read: if true allows the Lambda to check the count.
        // Only create/update (no delete) prevents count resets via deletion.
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      match /weeklyCheckin/{week} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /missions/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /learningPath/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Phase 3 (HSD Family) — per-activity completion/progress for the
      // account owner's own "self" profile (see src/lib/profiles.js).
      // Same owner-only pattern as every other per-uid subcollection here.
      match /activityProgress/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Monkey Yoga V2 integration (2026-09-10) — this learner's own
      // curriculum position (individualPosition) and home-practice history.
      // Security correction: WRITE moved server-side (see
      // netlify/functions/record-curriculum-progress.js) so every field is
      // validated against V2's real curriculum ids before it reaches
      // Firestore — the service account bypasses this write:false. READ
      // stays owner-only client-side (unchanged, always was safe). Never
      // written by anyone but the server on the account's own behalf —
      // classroomPosition lives entirely in /classes below and this doc has
      // no path that can touch it.
      match /curriculumProgress/{curriculumId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;

        match /homePracticeLog/{entryId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }

        // Idempotency markers (correction #5) — server-internal only, no
        // client ever needs to read or write these directly.
        match /processedEvents/{eventId} {
          allow read, write: if false;
        }
      }

      match /familyMembers/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /learningPath/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        // Phase 3 (HSD Family) — per-activity completion/progress for a
        // child profile. Same owner-only pattern; a child has no
        // independent Firebase Auth session (Phase 1 §9), so all writes
        // here happen through the parent's authenticated session.
        match /activityProgress/{activityId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        // Same curriculum-progress shape as the self-profile version above —
        // read owner-only client-side, write server-only.
        match /curriculumProgress/{curriculumId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;

          match /homePracticeLog/{entryId} {
            allow read: if request.auth != null && request.auth.uid == uid;
            allow write: if false;
          }

          match /processedEvents/{eventId} {
            allow read, write: if false;
          }
        }
      }

      match /notifications/{notifId} {
        allow read, update: if request.auth != null && request.auth.uid == uid;
        allow create: if isAdminEmail();
        allow delete: if false;
      }

      match /coachingCards/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /careerReady/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /globalReady/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Monkeys Unlock save state — server write only, via monkeys-save.js
      // (service-account auth, same pattern as learnerProfiles below). The
      // sub-app has no client-side Firebase Auth session, so it can't be
      // owner-write like careerReady/globalReady above.
      match /monkeysUnlock/{doc} {
        allow read, write: if false;
      }
    }

    // ── Learner Intelligence profiles — owner read, server write ──────────
    // Server writes via /api/intelligence and /api/chat (using Firebase API key)
    // Clients can read their own profile for dashboard display
    match /learnerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // Interaction log — owner read only
      match /interactions/{interactionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Confidence history — owner read only
      match /confidenceHistory/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // EIKEN placement/mock-test/achievement records — owner read only,
      // written server-side via eiken-progress.js (firebase-admin bypasses
      // this write:false, same pattern as the profile doc itself).
      match /eikenPlacementResults/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /eikenMockAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /eikenAchievements/{achievementId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /monkeyPartySessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── Support messages — user owns thread, admin reads all ─────────────
    match /support/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdminEmail());

      match /messages/{msgId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isAdminEmail());
      }
    }

    // ── Workbook redemption log — user create only (no edit/delete), admin read ─
    match /workbookRedemptions/{docId} {
      allow read: if isAdminEmail();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Admin audit log — any auth'd user can append, only admin can read ─
    match /adminLogs/{logId} {
      allow read: if isAdminEmail();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── HSD Family beta invites (Phase 4, 2026-09-09) — admin manages
    // (creates/views) invite codes here; the actual redemption
    // (netlify/functions/redeem-beta-invite.js) writes via the service
    // account, which bypasses this rule entirely. No client (including the
    // invited family) ever reads or writes this collection directly — the
    // code is only ever validated server-side, so it can't be enumerated
    // or self-redeemed by editing Firestore from the browser.
    match /betaInvites/{code} {
      allow read, write: if isAdminEmail();
    }

    // ── HSD Family beta feature flags (Phase 4, item 23) — same
    // admin-write/public-read shape as config/killSwitch (Phase 0), reusing
    // that already-hardened pattern rather than inventing a new one. Every
    // AI Netlify function that needs to check "is Family/Jona/TTS disabled"
    // polls this doc unauthenticated (same reason config/killSwitch's read
    // is public), so read stays open; only admin (or the service account,
    // which bypasses this) can flip a flag.
    match /familyFlags/{docId} {
      allow read:           if true;
      allow create, update: if isAdminEmail();
      allow delete:          if false;
    }

    // ── Minimal classroom connection (2026-09-10) — NOT an LMS: the only
    // capability is "a teacher/admin sets which book/lesson a class is
    // currently on". No assignments, grading, attendance, or per-student
    // records live here — those stay in curriculumProgress above, owned by
    // each learner's own account. Read is open to any authenticated user
    // (not just admin) because HSD Family's routing (any signed-in parent)
    // needs to look up their own child's classroom position by querying
    // learnerKeys — the doc contains no PII, only curriculum-position
    // metadata, so broad authenticated read is an acceptable, minimal-risk
    // trade-off rather than an unenumerable per-child security-rule query.
    // Write (creating a class, changing its book/lesson, roster changes)
    // stays admin-only, same as every other admin-managed collection here.
    // Security correction (Phase A/B review) — broad authenticated read was
    // wrong: uid/profileId values in learnerKeys are user-linked
    // identifiers, and any signed-in stranger could otherwise enumerate
    // every family's class membership, teacher uid, and curriculum pace.
    // Admin-only now on both sides. A parent/learner resolves their OWN
    // classroom position exclusively through the server-authenticated
    // netlify/functions/get-classroom-position.js, which verifies their
    // identity and returns only their own learner's position — never the
    // full document, never the roster.
    match /classes/{classId} {
      allow read, write: if isAdminEmail();
    }

    // ── Pathway/profile analytics (Phase 1, 2026-09-09) — same append-only
    // pattern as adminLogs above: the writer can only be the authenticated
    // account the event is about (checked via uid on the event doc itself),
    // never read back except by admin, never edited/deleted client-side.
    match /pathwayEvents/{eventId} {
      allow read: if isAdminEmail();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ── Admin config (DPA statuses, compliance settings) — admin only ────
    match /adminConfig/{docId} {
      allow read, write: if isAdminEmail();
    }

    // ── User feedback / pulse — any auth'd user can submit, only admin can read ─
    match /feedback/{docId} {
      allow read: if isAdminEmail();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Gemini activity log — server writes (no auth), admin read only ────
    // Netlify functions write using the client API key (no Firebase auth token).
    // allow create: if true is intentional — this is an append-only audit log.
    match /geminiActivity/{eventId} {
      allow read: if isAdminEmail();
      allow create: if true;
      allow update, delete: if false;
    }

    // ── API cost tracking — Netlify TTS writes (no auth), admin read ────────
    match /apiCosts/{date} {
      allow read:          if isAdminEmail();
      allow create, update: if true;   // Netlify functions write via REST without auth token
      allow delete:         if false;
    }

    // ── Kill switch config — public read (every AI function checks this
    // before running), admin/service-account write only ─────────────────────
    // Previously "allow create, update: if true" — anyone could flip the
    // platform-wide AI/TTS kill switch with no login at all via a raw
    // Firestore REST PATCH; the passcode in kill-switch.js never protected
    // this because Firestore rules, not the function's own logic, are what
    // Firestore actually enforces. kill-switch.js now writes via the
    // service-account-authenticated firestoreFetch (_firebaseAdmin.js),
    // which bypasses these rules entirely, so writes can be locked down to
    // admin-only without breaking the legitimate kill switch. Read stays
    // public because every AI Netlify function (chat.js, coaching-card.js,
    // etc.) polls this doc via a bare API-key request (no auth token) to
    // decide whether to run at all — the doc's contents (a few booleans)
    // were never the sensitive part, only who could change them.
    match /config/{docId} {
      allow read:           if true;
      allow create, update: if isAdminEmail();
      allow delete:         if false;
    }

    // ── Sip Speak Learn: Table Mode + Host Mode events (Phases 5-6) ─────────
    // Event codes — public read for code lookup (mirrors referralLinks), host-only write.
    match /sslEventCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sslEvents/{eventId} {
      allow read: if request.auth != null;
      // Only the host can create/modify their event, with one carve-out:
      // joining participants self-assign a table via a transaction that
      // increments nextAssignIndex on this doc, so that single field is
      // writable by any auth'd participant.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.hostUid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nextAssignIndex"])
      );
      allow delete: if false;

      // Table docs: the host can do anything to any table in their event.
      // Any other auth'd participant may only touch the fields Table Mode's
      // own actions actually write — status/question ("We're Finished",
      // "Another Question", Easier/Deeper) and participantCount (bumped by
      // the seat-assignment transaction) — never tableNumber or arbitrary
      // fields.
      // NOTE on create: tables are provisioned in the SAME atomic batch as
      // the parent event doc's own creation (see hostStore.createEvent). A
      // get() on the parent here would see pre-batch state — the event
      // doesn't exist yet from the rules engine's point of view — so any
      // hostUid check on create always fails the whole batch. create is left
      // open to any auth'd user for this reason; update/delete (which only
      // ever happen after the event already exists as a prior, separate,
      // committed write) safely use get() to verify the host.
      match /tables/{tableId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/sslEvents/$(eventId)).data.hostUid;
        allow update: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/sslEvents/$(eventId)).data.hostUid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "question", "message", "messageAt", "participantCount"])
        );
      }
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Sip Speak Learn: saved host event templates (Phase 6) ──────────────
    match /sslEventTemplates/{templateId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.hostUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
