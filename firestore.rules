rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read-only meta (signup counter) ─────────────────────────────
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── AI cache — public read (cache hits), server write only ─────────────
    match /aiCache/{hash} {
      allow read: if true;
      allow write: if false;
    }

    // ── Platform analytics — public read, server write only ────────────────
    // log-page-view writes via service account (bypasses these rules)
    match /analytics/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── App Registry — public read, server write only ──────────────────────
    match /appRegistry/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Referral links — public read (code lookup), owner write ───────────
    match /referralLinks/{code} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // ── Referral stats — owner read only, server write ────────────────────
    match /referrals/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── User profiles — owner read/write, admin read-all ─────────────────
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == "hearseedo.english@gmail.com");
      allow write: if request.auth != null && request.auth.uid == uid;

      match /chatUsage/{day} {
        // Lambda reads/writes without a Firebase auth token (server-side rate-limit counter).
        // read: if true allows the Lambda to check the count.
        // Only create/update (no delete) prevents count resets via deletion.
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      match /weeklyCheckin/{week} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /missions/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /learningPath/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /familyMembers/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /learningPath/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /notifications/{notifId} {
        allow read, update: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
        allow delete: if false;
      }

      match /coachingCards/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /careerReady/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /globalReady/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Monkeys Unlock save state — server write only, via monkeys-save.js
      // (service-account auth, same pattern as learnerProfiles below). The
      // sub-app has no client-side Firebase Auth session, so it can't be
      // owner-write like careerReady/globalReady above.
      match /monkeysUnlock/{doc} {
        allow read, write: if false;
      }
    }

    // ── Learner Intelligence profiles — owner read, server write ──────────
    // Server writes via /api/intelligence and /api/chat (using Firebase API key)
    // Clients can read their own profile for dashboard display
    match /learnerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // Interaction log — owner read only
      match /interactions/{interactionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Confidence history — owner read only
      match /confidenceHistory/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // EIKEN placement/mock-test/achievement records — owner read only,
      // written server-side via eiken-progress.js (firebase-admin bypasses
      // this write:false, same pattern as the profile doc itself).
      match /eikenPlacementResults/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /eikenMockAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /eikenAchievements/{achievementId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /monkeyPartySessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── Support messages — user owns thread, admin reads all ─────────────
    match /support/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == "hearseedo.english@gmail.com");

      match /messages/{msgId} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == "hearseedo.english@gmail.com");
      }
    }

    // ── Workbook redemption log — user create only (no edit/delete), admin read ─
    match /workbookRedemptions/{docId} {
      allow read: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Admin audit log — any auth'd user can append, only admin can read ─
    match /adminLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Admin config (DPA statuses, compliance settings) — admin only ────
    match /adminConfig/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
    }

    // ── User feedback / pulse — any auth'd user can submit, only admin can read ─
    match /feedback/{docId} {
      allow read: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Gemini activity log — server writes (no auth), admin read only ────
    // Netlify functions write using the client API key (no Firebase auth token).
    // allow create: if true is intentional — this is an append-only audit log.
    match /geminiActivity/{eventId} {
      allow read: if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create: if true;
      allow update, delete: if false;
    }

    // ── API cost tracking — Netlify TTS writes (no auth), admin read ────────
    match /apiCosts/{date} {
      allow read:          if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create, update: if true;   // Netlify functions write via REST without auth token
      allow delete:         if false;
    }

    // ── Kill switch config — Netlify function writes, admin read ─────────────
    match /config/{docId} {
      allow read:          if request.auth != null && request.auth.token.email == "hearseedo.english@gmail.com";
      allow create, update: if true;   // kill-switch.js writes via REST without auth token
      allow delete:         if false;
    }

    // ── Sip Speak Learn: Table Mode + Host Mode events (Phases 5-6) ─────────
    // Event codes — public read for code lookup (mirrors referralLinks), host-only write.
    match /sslEventCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sslEvents/{eventId} {
      allow read: if request.auth != null;
      // Only the host can create/modify their event, with one carve-out:
      // joining participants self-assign a table via a transaction that
      // increments nextAssignIndex on this doc, so that single field is
      // writable by any auth'd participant.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.hostUid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nextAssignIndex"])
      );
      allow delete: if false;

      // Table docs: host controls these broadly, but participants also write
      // their own table's live question/status as part of Table Mode actions
      // (e.g. "We're Finished") and the seat-assignment transaction bumps
      // participantCount. Tightening this to per-field/per-table ownership is
      // a fast-follow once the app is closer to production navigation.
      match /tables/{tableId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Sip Speak Learn: saved host event templates (Phase 6) ──────────────
    match /sslEventTemplates/{templateId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.hostUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
